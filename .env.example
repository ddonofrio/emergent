# Providers are attempted in this order. Leave both unset for the scripted demo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=120000
LOCAL_LLM_API_KEY=local-lm-studio
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=omnicoder-9b
# Optional positive integer. Empty means unlimited agent decisions.
AGENT_MAX_TURNS=
WORLD_START_PAUSED=false
PORT=3000
DATA_DIR=data
EMERGENT_MODULE=first-shore
