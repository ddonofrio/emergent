# One continuous conversation per agent; active providers use ordered fallback.
# Configure more models in Settings (server-only <DATA_DIR>/inference-config.json).
EMERGENT_LLM_BASE_URL=
EMERGENT_LLM_MODEL=
EMERGENT_LLM_API_KEY=
PORT=3000
DATA_DIR=data
# Comma-separated public origins accepted by the server when it runs behind a reverse proxy.
PUBLIC_ORIGINS=
