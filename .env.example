# Providers are attempted in this order. Without an active provider, agents start paused.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=120000
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=
# Optional tie-breaker when LM Studio has more than one loaded language model.
LOCAL_LLM_MODEL=
# Optional positive integer. Empty means unlimited agent decisions.
AGENT_MAX_TURNS=
# Explicit opt-in for deterministic scripted actions when no provider is configured.
SCRIPTED_DEMO=false
PORT=3000
DATA_DIR=data
