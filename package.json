{
  "name": "emergent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:startup": "tsx scripts/check-startup.ts",
    "test": "tsx --test tests/*.test.ts",
    "benchmark:agents": "tsx scripts/benchmark-agents.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1158.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1158.0",
    "@earendil-works/pi-ai": "0.82.1",
    "fastnoise-lite": "1.1.1",
    "three": "0.186.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
